# Copy to ~/.config/lucy/mcp.toml
# HyprFast is built into Lucy and is discovered automatically with:
#   hyprfast mcp
# Do not add HyprFast here unless you intentionally want another server entry.

[[servers]]
name = "slack"
command = "npx"
args = ["-y", "@modelcontextprotocol/server-slack"]

[servers.env]
SLACK_BOT_TOKEN = "xoxb-..."

[[servers]]
name = "github"
command = "npx"
args = ["-y", "@modelcontextprotocol/server-github"]

[servers.env]
GITHUB_PERSONAL_ACCESS_TOKEN = "..."
