# Copy to ~/.config/lucy/mcp.toml
# HyprFast is built in: Lucy automatically starts `hyprfast mcp` when
# the executable is available. You do NOT need to add it here.

# Other MCP servers can be added below and are started when Lucy initializes.
# [[servers]]
# name = "slack"
# command = "npx"
# args = ["-y", "@modelcontextprotocol/server-slack"]
#
# [servers.env]
# SLACK_BOT_TOKEN = "xoxb-..."

# [[servers]]
# name = "github"
# command = "npx"
# args = ["-y", "@modelcontextprotocol/server-github"]
#
# [servers.env]
# GITHUB_PERSONAL_ACCESS_TOKEN = "..."
