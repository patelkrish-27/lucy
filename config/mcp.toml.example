# Copy to ~/.config/lucy/mcp.toml
# HyprFast is built into Lucy and is discovered automatically with:
#   hyprfast mcp
# Do not add HyprFast here unless you intentionally want another server entry.
#
# This file is entirely optional. With no mcp.toml, Lucy still runs with its
# built-in tool catalog plus HyprFast.
#
# A server that fails to start is reported at startup and by `/doctor` — it no
# longer disappears silently.

# Slack
# The old `@modelcontextprotocol/server-slack` is DEPRECATED on npm
# ("Package no longer supported") and pins MCP SDK 1.0.1. Slack's own official
# server is Streamable-HTTP at https://mcp.slack.com/mcp and needs a registered
# Slack app plus OAuth, which Lucy's stdio MCP client cannot speak.
# This community stdio server is the working option today.
[[servers]]
name = "slack"
command = "npx"
args = ["-y", "mcp-remote", "https://mcp.slack.com/mcp"]

# Simpler alternative if you only have a bot token and need no OAuth:
# command = "npx"
# args = ["-y", "mcp-slack", "--transport", "stdio"]
# [servers.env]
# SLACK_BOT_TOKEN = "xoxb-..."
# SLACK_TEAM_ID = "T01234567"

[[servers]]
name = "github"
command = "npx"
args = ["-y", "@modelcontextprotocol/server-github"]

[servers.env]
GITHUB_PERSONAL_ACCESS_TOKEN = "..."
