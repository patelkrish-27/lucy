{"nodes": [{"id": "skills_lucy_skill_lucy_base_skill", "label": "Lucy Base Skill (single consulted skill)", "file_type": "document", "source_file": "skills/lucy/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_lucy_skill_local_tools", "label": "Local Tools (shell/read_file/write_file/edit_file/list_dir/search_files/git/glob)", "file_type": "concept", "source_file": "skills/lucy/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_lucy_skill_shell_dangerous_guard", "label": "Shell Dangerous-Command Guard (LUCY_ALLOW_DANGEROUS)", "file_type": "rationale", "source_file": "skills/lucy/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "rm -rf /, mkfs, dd if=, fork bombs and shutdown/reboot/poweroff are blocked unless LUCY_ALLOW_DANGEROUS=1, with a 120s timeout and 64KB output cap, because shell is the only tool with environment-level blast radius."}, {"id": "skills_lucy_skill_extra_mcp_servers", "label": "Extra MCP Servers from mcp.toml", "file_type": "concept", "source_file": "skills/lucy/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_lucy_skill_hyprfast", "label": "hyprfast Tool Surface (47 tools)", "file_type": "concept", "source_file": "skills/lucy/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_lucy_skill_cdp_browser_automation", "label": "CDP Browser Automation Layer", "file_type": "concept", "source_file": "skills/lucy/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_lucy_skill_stagehand", "label": "Stagehand LLM Automation", "file_type": "concept", "source_file": "skills/lucy/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_lucy_skill_stagehand_first_priority", "label": "Stagehand to Eval to Snapshot to Screenshot Priority (0.6)", "file_type": "rationale", "source_file": "skills/lucy/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CDP eval is fast but Stagehand handles AX mapping, twoStep dropdowns, self-heal and ref invalidation robustly, so Stagehand goes first and screenshots are verify-only (~50ms per key versus a 2-4s vision loop)."}, {"id": "skills_lucy_skill_stagehand_config", "label": "StagehandConfig::from_env", "file_type": "code", "source_file": "skills/lucy/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_lucy_skill_browserbase_stagehand_citation", "label": "browserbase/stagehand 4.0.2", "file_type": "concept", "source_file": "skills/lucy/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_lucy_skill_task_state", "label": "Task State Persistent Todo (hyprfast-tasks.json)", "file_type": "concept", "source_file": "skills/lucy/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_lucy_skill_screenshot_session_tracking", "label": "Screenshot Session Auto-Tracking", "file_type": "concept", "source_file": "skills/lucy/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_lucy_skill_whatsapp_keyboard_protocol", "label": "WhatsApp Web Keyboard Protocol", "file_type": "concept", "source_file": "skills/lucy/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_lucy_skill_whatsapp_fullscreen_rule", "label": "WhatsApp Fullscreen Window Rule", "file_type": "rationale", "source_file": "skills/lucy/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A tiled WhatsApp window in Brave traps focus in the omnibox overlay so ctrl+alt+/ and typing get stuck; the window is moved to an empty workspace and fullscreened before any keyboard flow."}, {"id": "skills_lucy_skill_whatsapp_dom_selectors", "label": "WhatsApp Web DOM Selectors", "file_type": "concept", "source_file": "skills/lucy/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_lucy_skill_safety", "label": "Safety Rules (confirm before send, re-verify desktop, prefer address: selector)", "file_type": "concept", "source_file": "skills/lucy/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_lucy_skill_tab_dedup_resume", "label": "State-Aware Resume and Tab Deduplication", "file_type": "rationale", "source_file": "skills/lucy/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Before navigating, an existing page tab with the same host/query is reused via /json/activate and location.href is verified, because restarting from step 1 or opening a second tab wastes work and browser_snapshot alone is unreliable with multiple tabs."}, {"id": "skills_lucy_skill_renderer_accessibility_gotcha", "label": "--force-renderer-accessibility Gotcha", "file_type": "rationale", "source_file": "skills/lucy/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Brave's AT-SPI tree is empty without --force-renderer-accessibility, and because Brave is single-instance, --new-window on a running process inherits the missing flag; CDP AX via Stagehand works without it and is therefo