ype": "code", "source_file": "docs/lucy-performance.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_lucy_performance_predict_speculative", "label": "predict_speculative (fused Laya fan-out)", "file_type": "code", "source_file": "docs/lucy-performance.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_lucy_performance_evaluate_choice_batch", "label": "evaluate_choice_batch (chunked Laya calls)", "file_type": "code", "source_file": "docs/lucy-performance.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_lucy_performance_owned_tab", "label": "Dedicated Owned Tab (PUT /json/new + Page.navigate)", "file_type": "code", "source_file": "docs/lucy-performance.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_lucy_performance_verify_done", "label": "verify_done / verify_done_independently", "file_type": "code", "source_file": "docs/lucy-performance.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_lucy_performance_snapshot_hash_thrashing", "label": "snapshot_hash / is_thrashing (3x no-change)", "file_type": "code", "source_file": "docs/lucy-performance.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_lucy_performance_gap_scroll_dropped", "label": "P0 Gap: Scroll Dropped in observed()", "file_type": "rationale", "source_file": "docs/lucy-performance.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "browser_policy.rs observed() filters to click/fill/select, so scroll never reaches the policy and below-fold targets are unreachable; the feed bench failing with max_steps is the proof."}, {"id": "docs_lucy_performance_gap_wait_for_load_polls", "label": "P0 Gap: wait_for_load Burns Full Polls", "file_type": "rationale", "source_file": "docs/lucy-performance.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "300ms double-stable (text,inter,href) polling up to 20s burns roughly 60 polls on streaming SPAs even though the timeout is best-effort, so CDP cost is dominated by waiting rather than snapshots."}, {"id": "docs_lucy_performance_gap_laya_fanout", "label": "P0 Gap: Per-Step Laya Fan-Out", "file_type": "rationale", "source_file": "docs/lucy-performance.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "pick_element fans out to up to five evaluate_choice_batch chunks per step, so Laya was not fused (10 predicts for 10 steps); P1 collapses it to one speculative forward pass per fan-out."}, {"id": "docs_lucy_performance_gap_typing_enter", "label": "P0 Gap: Typing Always Sends Enter", "file_type": "rationale", "source_file": "docs/lucy-performance.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "fill does selectAll then insertText then Enter unconditionally, which hides combobox suggestions; making Enter conditional is required rather than worked around in probes."}, {"id": "docs_lucy_performance_gap_anti_thrash_verifier", "label": "P0 Gap: No Anti-Thrash or DONE Verifier", "file_type": "rationale", "source_file": "docs/lucy-performance.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "run_browser_loop had no 3x-no-change blocked check and no independent verification of open/finish before reporting Done, so a thrashing loop looked like success."}, {"id": "docs_lucy_performance_probe_covered_rejected", "label": "Probe: covered_rejected (elementFromPoint hit-test)", "fil