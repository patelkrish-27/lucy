{"nodes": [{"id": "docs_lucy_harness_architecture_minimal_call_design", "label": "Harness Architecture v2: Minimal-Call, Zero-Ambiguity Design", "file_type": "document", "source_file": "docs/lucy-harness-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_lucy_harness_architecture_v2_harness", "label": "v2 Harness (crates/lucy-runtime/src/harness.rs)", "file_type": "code", "source_file": "docs/lucy-harness-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_lucy_harness_architecture_v1_pipeline", "label": "v1 TRIAGE / Tool Selector / Closed-Loop Controller Pipeline (planner.rs)", "file_type": "code", "source_file": "docs/lucy-harness-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_lucy_harness_architecture_observed_trace", "label": "Observed 13-Call Trace", "file_type": "concept", "source_file": "docs/lucy-harness-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_lucy_harness_architecture_failure_no_native_tool_calling", "label": "Failure: No Native Tool Calling", "file_type": "rationale", "source_file": "docs/lucy-harness-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pasting tool descriptions into the user message and parsing hand-rolled JSON blocks the model from expressing multi-step tool sequences, requires brittle bespoke parsing, and forfeits native parallel tool calls."}, {"id": "docs_lucy_harness_architecture_failure_llm_call_per_action", "label": "Failure: One LLM Call Per Action Plus Per Verification", "file_type": "rationale", "source_file": "docs/lucy-harness-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A dedicated Tool Selector per subtask plus a Closed-Loop Controller after every result turns a single click into three LLM round-trips before any task progress is made."}, {"id": "docs_lucy_harness_architecture_failure_env_bootstrap_via_reasoning", "label": "Failure: Environment Bootstrapping Routed Through Reasoning Model", "file_type": "rationale", "source_file": "docs/lucy-harness-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Whether the browser runs with --remote-debugging-port is deterministic and checkable in milliseconds, yet 8 of 13 LLM calls were spent guessing binary names and racing the port; this needed a state machine, not judgment."}, {"id": "docs_lucy_harness_architecture_failure_plan_loses_goal", "label": "Failure: Plan Can Silently Lose the Original Goal", "file_type": "rationale", "source_file": "docs/lucy-harness-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replans splice in new subtasks without re-queueing the original goal subtask, so the run ended with decision=continue and an empty remaining_plan having never navigated to YouTube; no invariant forbade the plan from emptying out."}, {"id": "docs_lucy_harness_architecture_design_principles", "label": "Five Load-Bearing Design Principles", "file_type": "concept", "source_file": "docs/lucy-harness-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_lucy_harness_architecture_principle_one_call_plans_many_tools_execute", "label": "Principle: One Call Plans, Many Tools Execute", "file_type": "rationale", "source_file": "docs/lucy-harness-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Planning and execution are different concerns and must not be interleaved into one-tool-call-one-round-trip: the LLM decides the sequence, the runtime executes it without returning to the LLM unless it deviates."}, {"id": "docs_lucy_harness_architecture_principle_determinism_before_reasoning", "label": "Principle: Determinism Before Reasoning", "file_type": "rationale", "source_file": "docs/lucy-harness-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Anything with a fixed, checkable answer is handled by code; the LLM is reserved for intent, tool selection under ambiguity, and success/failure interpretation."}, {"id": "docs_lucy_harness_architecture_principle_verify_outcome_not_step", "label": "Principle: Verify the Outcome, Not the Step", "file_type": "rationale", "source_file": "docs/lucy-harness-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "success:true or HTTP 200 is not evidence of task success, so verification happens once per plan against the user's success condition rather than after every individual tool call."}, {"id": "docs_lucy_harness_architecture_principle_goal_first_class", "label": "Principle: The Goal Is a First-Class Object That Cannot Be Dropped", "file_type": "rationale", "source_file": "docs/lucy-harness-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The original goal and success condition live outside the mutable subtask queue in session state for the whole run, so no replan, recovery, or infra fix-up may complete a run without re-checking that success condition."}, {"id": "docs_lucy_harness_architecture_principle_escalate_on_deviation_only", "label": "Principle: Escalate to the LLM Only on Genuine Deviation", "file_type": "rationale", "source_file": "docs/lucy-harness-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Expected, scriptable failures (browser not running, tab not found, element not yet rendered) go through deterministic retry/bootstrap first; the LLM sees them only if deterministic recovery also fails."}, {"id": "docs_lucy_harness_architecture_call_budget", "label": "Target LLM Call Budget", "file_type": "concept", "source_file": "docs/lucy-harness-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_lucy_harness_architecture_router_intent_classifier", "label": "Router / Intent Classifier (Call 1)", "file_type": "concept", "source_file": "docs/lucy-harness-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_lucy_harness_architecture_deterministic_preflight", "label": "Deterministic Preflight (0 LLM calls)", "file_type": "concept", "source_file": "docs/lucy-harness-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_lucy_harness_architecture_preflight_browser", "label": "preflight_browser State Machine", "file_type": "code", "source_file": "docs/lucy-harness-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_lucy_harness_architecture_planner_executor", "label": "Planner-Executor (Call 2)", "file_type": "concept", "source_file": "docs/lucy-harness-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_lucy_harness_architecture_tool_runtime", "label": "Tool Runtime (0 LLM calls)", "file_type": "concept", "source_file": "docs/lucy-harness-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_lucy_harness_architecture_execution_trace", "label": "execution_trace Object", "file_type": "concept", "source_file": "docs/lucy-harness-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_lucy_harness_architecture_deterministic_recovery_table", "label": "Deterministic Recovery Table", "file_type": "concept", "source_file": "docs/lucy-harness-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_lucy_harness_architecture_recovery_call", "label": "Scoped Recovery Call", "file_type": "concept", "source_file": "docs/lucy-harness-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_lucy_harness_architecture_verifier", "label": "Verifier (Final Call)", "file_type": "concept", "source_file": "docs/lucy-harness-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_lucy_harness_architecture_session_goal_object", "label": "Immutable Session Goal Object", "file_type": "concept", "source_file": "docs/lucy-harness-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_lucy_harness_architecture_ambiguity_policy", "label": "Ambiguity Policy (Kept, Tightened)", "file_type": "concept", "source_file": "docs/lucy-harness-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_lucy_harness_architecture_destructive_action_gate", "label": "Destructive-Action Runtime Gate", "file_type": "rationale", "source_file": "docs/lucy-harness-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deletion, sending, purchasing and irreversible settings must require explicit confirmation via a runtime gate keyed off the capability index destructive flag, not something the model has to remember to apply."}, {"id": "docs_lucy_harness_architecture_batch_tool_schema_removal", "label": "Batch-Tool Preference by Schema Removal", "file_type": "rationale", "source_file": "docs/lucy-harness-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The old prompt merely stated a batch-tool preference and the model ignored it, so redundant single-action tools are removed from the offered tools array; a tool the model cannot see cannot be picked."}, {"id": "docs_lucy_harness_architecture_open_x_no_new_window", "label": "Open X Never Means Launch a Second Window", "file_type": "rationale", "source_file": "docs/lucy-harness-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If a usable browser context already exists, browser_open is removed from the offered tool list for that call; removing the footgun from the schema is stronger than asking the model not to pick it."}, {"id": "docs_lucy_harness_architecture_data_contracts", "label": "Strict JSON Schema Data Contracts", "file_type": "rationale", "source_file": "docs/lucy-harness-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every LLM response is machine-checked before another line of the harness runs, with reject-and-retry once then escalate; this is what removes ambiguity as a category of bug."}, {"id": "docs_lucy_harness_architecture_native_tools_parameter", "label": "Provider-Native tools Parameter and tool_calls Array", "file_type": "concept", "source_file": "docs/lucy-harness-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_lucy_harness_architecture_router_planner_merge", "label": "Merging Router + Planner for Simple Tasks", "file_type": "concept", "source_file": "docs/lucy-harness-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_lucy_harness_architecture_router_planner_prompt", "label": "Combined Router + Planner-Executor Prompt", "file_type": "document", "source_file": "docs/lucy-harness-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_lucy_harness_architecture_recovery_prompt", "label": "Scoped Recovery Prompt", "file_type": "document", "source_file": "docs/lucy-harness-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_lucy_harness_architecture_verifier_prompt", "label": "Verifier Prompt", "file_type": "document", "source_file": "docs/lucy-harness-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_lucy_harness_architecture_prompt_is_not_a_constraint", "label": "Prompts Are a Second Line of Defense", "file_type": "rationale", "source_file": "docs/lucy-harness-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An LLM instruction is a strong bias, not a hard constraint, so schema/tool availability, runtime-side validation and the destructive-action gate must be enforced in code regardless of the prompt."}, {"id": "docs_lucy_harness_architecture_implementation_checklist", "label": "Implementation Checklist for the Coding Agent", "file_type": "concept", "source_file": "docs/lucy-harness-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_lucy_harness_architecture_call_count_metric", "label": "Call-Count Instrumentation Metric", "file_type": "rationale", "source_file": "docs/lucy-harness-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Instrumenting call count per task from day one and alerting above the budget is what keeps the system honest as it grows past the YouTube example."}, {"id": "docs_lucy_harness_architecture_target_sequence", "label": "Target Sequence Diagram (YouTube/Despacito)", "file_type": "concept", "source_file": "docs/lucy-harness-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_lucy_harness_architecture_minimal_call_design", "target": "docs_lucy_harness_architecture_v2_harness", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/lucy-harness-architecture.md", "source_location": null, "weight": 1.0}, {"source": "docs_lucy_harness_architecture_minimal_call_design", "target": "docs_lucy_harness_architecture_v1_pipeline", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/lucy-harness-architecture.md", "source_location": null, "weight": 1.0}, {"source": "docs_lucy_harness_architecture_minimal_call_design", "target": "docs_lucy_harness_architecture_observed_trace", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/lucy-harness-architecture.md", "source_location": null, "weight": 1.0}, {"source": "docs_lucy_harness_architecture_minimal_call_design", "target": "docs_lucy_harness_architecture_call_budget", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/lucy-harness-architecture.md", "source_location": null, "weight": 1.0}, {"source": "docs_lucy_harness_architecture_observed_trace", "target": "docs_lucy_harness_architecture_failure_no_native_tool_calling", "relation"